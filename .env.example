APP_NAME=HentaiFlex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://hentaiflex.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hentai
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# Video Scraper Configuration
SCRAPE_TARGET_URL=
SCRAPE_AUTO_ON_FIRST_VISIT=true

# ==============================================================================
# Advertisement Configuration
# ==============================================================================
ADS_ENABLED=true
ADS_SHOW_PLACEHOLDERS=true
ADS_HEAD_SCRIPT="<meta name=\"6a97888e-site-verification\" content=\"d2f41d24add6224e9e65403281a4372f\"><script async type=\"application/javascript\" src=\"https://a.magsrv.com/ad-provider.js\"></script>"

# Header Leaderboard Banner (728x90 / 320x50)
ADS_HEADER_ENABLED=true
ADS_HEADER_CODE=

# Watch Page - Below Video Player (Native Recommendation 4x1)
ADS_WATCH_BELOW_PLAYER_ENABLED=true
ADS_WATCH_BELOW_PLAYER_CODE="<ins class=\"eas6a97888e20\" data-zoneid=\"6096680\"></ins><script>(AdProvider = window.AdProvider || []).push({\"serve\": {}});</script>"

# Watch Page - Sidebar Ad (300x250 Medium Rectangle - Zone 6096674)
ADS_WATCH_SIDEBAR_ENABLED=true
ADS_WATCH_SIDEBAR_CODE="<ins class=\"eas6a97888e2\" data-zoneid=\"6096674\"></ins><script>(AdProvider = window.AdProvider || []).push({\"serve\": {}});</script>"

# Homepage - In-Feed Video Grid Ad (Recommendation Widget - Zone 6096680)
ADS_GRID_FEED_ENABLED=true
ADS_GRID_FEED_CODE="<ins class=\"eas6a97888e20\" data-zoneid=\"6096680\"></ins><script>(AdProvider = window.AdProvider || []).push({\"serve\": {}});</script>"

# Sticky Floating Bottom Banner (728x90 / 320x50)
ADS_FOOTER_STICKY_ENABLED=true
ADS_FOOTER_STICKY_CODE=

# Homepage Bottom Leaderboard Banner (728x90 / 320x50)
ADS_HOME_BOTTOM_ENABLED=true
ADS_HOME_BOTTOM_CODE=

# Popunder / On-Click Ad (Zone 6096676 - Loaded before </body>)
ADS_POPUNDER_ENABLED=true
ADS_POPUNDER_CODE="<ins class=\"eas6a97888e\" data-zoneid=\"6096676\"></ins><script>(AdProvider = window.AdProvider || []).push({\"serve\": {}});</script>"

# On-Click Popunder Monetization Engine (#1 Highest Profit)
ADS_ONCLICK_ENABLED=true
